{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ws/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/banner.jpg",
      "destination": "/banner.jpg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
